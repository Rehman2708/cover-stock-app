{
  "expo": {
    "name": "CoverStock",
    "slug": "coverstock",
    "scheme": "coverstock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/coverStockIcon.png",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rehman2708.app"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#4E5251",
        "foregroundImage": "./assets/coverStockIcon.png"
      },
      "package": "com.rehman2708.app"
    },
    "web": {
      "favicon": "./assets/coverStockIcon.png",
      "splash": {
        "backgroundColor": "#4E5251",
        "resizeMode": "contain",
        "image": "./assets/coverStockIcon.png"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4E5251",
          "image": "./assets/coverStockIcon.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-secure-store"
    ]
  }
}
